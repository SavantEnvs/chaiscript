// Known-answer script for mayhem/test.sh: the output of this program is compared byte-for-byte
// with mayhem/oracle.expected, so an interpreter that does nothing (or computes wrongly) fails.
def fib(n) { if (n < 2) { return n; } else { return fib(n - 1) + fib(n - 2); } }

class Counter {
  attr n;
  def Counter() { this.n = 0; }
  def bump(k) { this.n += k; return this.n; }
}

var c = Counter();
c.bump(5);
c.bump(37);

var v = [3, 1, 4, 1, 5, 9, 2, 6];
var total = 0;
for (x : v) { total += x; }

var m = ["a": 1, "b": 22];
var adder = fun(a) { return fun[a](b) { return a + b; }; };

print(2 + 3 * 4);
print(fib(15));
print(c.n);
print(total);
print(v.size());
print(m["b"]);
print(adder(40)(2));
print("chai" + "script");
print(to_string(7 / 2) + "," + to_string(7.0 / 2.0));
print(join(map(v, fun(e) { e * e }), "-"));
try { throw("boom"); } catch (e) { print("caught " + e); }
